NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taskhub:taskhub@localhost:5432/taskhub
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=<96-char hex string>
JWT_REFRESH_SECRET=<a different 96-char hex string>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HOPS=0
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=TaskHub <no-reply@taskhub.local>
JOB_BACKOFF_MS=2000
OVERDUE_SCAN_CRON=*/1 * * * *